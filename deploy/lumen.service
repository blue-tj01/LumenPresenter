# systemd unit for Lumen Presenter. Adjust User and paths, then:
#   sudo cp deploy/lumen.service /etc/systemd/system/ && sudo systemctl enable --now lumen
[Unit]
Description=Lumen Presenter
After=network-online.target
Wants=network-online.target

[Service]
User=lumen
WorkingDirectory=/opt/lumen
ExecStart=/usr/bin/node /opt/lumen/server.js --host 0.0.0.0 --port 8642 --data /var/lib/lumen
# The access token is generated on first start and kept in /var/lib/lumen/settings.json (also printed to the
# journal). To choose your own instead:
#Environment=LUMEN_TOKEN=change-me
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
