{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "server.js", "server/**/*.js", "electron/**/*.js", "console/**/*.js", "sync.js", "render.js"]
}
