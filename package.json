{
  "name": "lumen-presenter",
  "version": "0.3.0",
  "private": true,
  "description": "A presentation app for worship services and live events.",
  "author": "Tom",
  "homepage": "https://github.com/blue-tj01/LumenPresenter",
  "desktopName": "lumen-presenter.desktop",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test tests/server.test.js tests/screens.test.js tests/data.test.js",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.lumenpresenter.app",
    "productName": "Lumen Presenter",
    "files": [
      "package.json",
      "server.js",
      "electron/**",
      "*.html",
      "*.css",
      "app.js",
      "render.js",
      "sync.js"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "blue-tj01",
      "repo": "LumenPresenter",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lumen-Presenter-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "AudioVideo",
      "maintainer": "Tom",
      "artifactName": "Lumen-Presenter-${version}-${arch}.${ext}",
      "syncDesktopName": true
    }
  }
}
